# Prefer one-shot setup (creates gitignored .env files + venvs):
#   Orin:  ./scripts/bootstrap.sh --role orin
#   Host:  ./scripts/bootstrap.sh --role host
#   Match token from Orin: ./scripts/bootstrap.sh --role host --pull-token-from go2-orin-wire
# Host link path: ./start_remote_console.sh --link wire|guest|dog_ap
#
# Manual templates (never commit real tokens or AES keys):
#   robot_agent/.env.example  -> robot_agent/.env on Orin
#   remote_client/.env.example -> remote_client/.env on the operator PC
#
# Go2 EDU LAN defaults used by this project:
#   Orin (robot agent)  192.168.123.18
#   Go2 MCU / WebRTC    192.168.123.161
#   MID-360 LiDAR       192.168.123.20
