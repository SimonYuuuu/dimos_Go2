ROBOT_AGENT_TOKEN=replace-with-shared-secret
# Default link; override per run: ./start_remote_console.sh --link guest|dog_ap|wire
LINK_PROFILE=wire
# ORIN_* below are defaults for wire; --link loads remote_client/link_profiles/<name>.env
ROBOT_AGENT_URL=http://192.168.123.18:8787
ORIN_SSH_TARGET=go2-orin-wire
ORIN_AGENT_HOST=192.168.123.18
ORIN_AGENT_PORT=8787
# Local tunnel ports (avoid 7779/9877/9878 — VS Code often owns those).
LOCAL_CC_PORT=17779
LOCAL_RERUN_WEB_PORT=19878
LOCAL_RERUN_GRPC_PORT=19877
LOCAL_RERUN_WS_PORT=13030
REMOTE_CONSOLE_HOST=127.0.0.1
REMOTE_CONSOLE_PORT=7781
