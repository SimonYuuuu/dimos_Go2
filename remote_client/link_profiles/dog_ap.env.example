# Host joins the Go2 body WiFi AP (near-range lab / short walk tests).
# MCU/AP gateway is often 192.168.12.1; Orin on EDU is commonly still
# 192.168.123.18 on the robot LAN — verify with ping while on the AP.
# If unreachable, put Orin's AP-side address below.
ORIN_SSH_TARGET=go2-orin-ap
ORIN_AGENT_HOST=192.168.123.18
ORIN_AGENT_PORT=8787
ROBOT_AGENT_URL=http://192.168.123.18:8787
