# Host + Orin both join the iPhone personal hotspot (调试首选；Guest WiFi 常隔离 SSH).
# Orin DHCP address may change — after Orin joins, check: ssh go2-orin-wire 'hostname -I'
# then set ORIN_AGENT_HOST to Orin's 172.20.10.x address.
ORIN_SSH_TARGET=go2-orin-iphone
ORIN_AGENT_HOST=172.20.10.4
ORIN_AGENT_PORT=8787
ROBOT_AGENT_URL=http://172.20.10.4:8787
