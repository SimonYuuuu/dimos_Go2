# ZF / warehouse Guest WiFi (dev only).
# Fill ORIN_AGENT_HOST with the address Orin gets on guest WiFi, then:
#   cp guest.env.example guest.env   # edit guest.env
# Guest SSIDs often enable client isolation — if ping/SSH fails, ask IT to allow
# device-to-device or use a dedicated ops SSID instead.
ORIN_SSH_TARGET=go2-orin-guest
ORIN_AGENT_HOST=SET_ME_GUEST_IP
ORIN_AGENT_PORT=8787
ROBOT_AGENT_URL=http://SET_ME_GUEST_IP:8787
