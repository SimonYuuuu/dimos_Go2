# Copy to robot_agent/.env on the Orin (gitignored). Token must match the remote client.
ROBOT_AGENT_TOKEN=replace-with-a-long-random-token
ROBOT_AGENT_HOST=0.0.0.0
ROBOT_AGENT_PORT=8787
ROBOT_IP=192.168.123.161
LIDAR_IP=192.168.123.20
GO2CONNECTION__AES_128_KEY=
DIMOS_MODE=real
# Patrol/localization stack (WebRTC + lidar-window reloc; no nix natives).
# Set PATROL_LOCALIZE_ONLY=1 to keep CC/Rerun up without starting waypoint navigation.
DIMOS_PATROL_BLUEPRINT=unitree-go2
DIMOS_RELOC_MODULE=lidar-window-relocalization
PATROL_LOCALIZE_ONLY=1
# Reloc ICP threshold (use with DIMOS_INITIAL_POSE; raise if false locks appear).
DIMOS_RELOC_FITNESS=0.72
# Attempt spacing / scan window (faster lock; settle still requires N agreeing hits).
DIMOS_RELOC_INTERVAL=0.3
DIMOS_RELOC_MIN_FRAMES=2
DIMOS_RELOC_SETTLE_N=3
# Required for reliable lock: dog at map origin facing +X → 0,0,0 (yaw radians).
# DIMOS_INITIAL_POSE=0,0,0
# Reject a lock that leaves the typed start on the loaded map.
DIMOS_RELOC_HINT_YAW_DEG=45
DIMOS_RELOC_HINT_XY_M=0.55
# false = keep matching the prior map for the whole patrol (settle V9).
# First lock is global. Later updates are one local ICP, at most 0.6 m / 20 deg.
DIMOS_RELOC_ONCE=false
# Sport Move API. Firmware avoidance stays off: it blocks open space ahead
# and still allows reverse. Patrol avoidance is the DimOS costmap.
# Set DIMOS_ENABLE_MCU_OBSTACLE_AVOIDANCE=1 only to turn the body bumper back on.
DIMOS_VELOCITY_API=1
# 1 = Rerun shows the dog, live lidar, the path, the obstacle map, and a 1 Hz camera.
# Loaded map is not sent. Set DIMOS_SHOW_LOADED_MAP=1 to include it (hidden until ticked).
# Global map is sent twice after localization locks, then stopped, so the pose can be checked.
DIMOS_RERUN_TRACK=1
# 1 = low fixed rates. Used only when DIMOS_RERUN_TRACK=0 (mapping).
DIMOS_RERUN_LITE=0
# Localization cloud (.pc2.lcm) and planning graph (.map.db) from one export.
# Patrol loads <name>.map.db beside the selected point cloud into the costmap.
# Smaller voxel + tighter pgo-tol keeps more frames; denoise drops floaters.
DIMOS_MAP_VOXEL=0.03
DIMOS_MAP_PGO_TOL=0.08
DIMOS_MAP_DENOISE=1
# Export device is chosen by export_map.sh: CUDA:0 when Open3D can see the GPU.
# DIMOS_MAP_FORCE_CPU=1 keeps the rebuild on CPU.
# DIMOS_MAP_FULL_PGO=0
